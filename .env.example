# Database (Neon or local Docker Postgres)
DATABASE_URL=postgres://planeat:planeat@localhost:5433/planeat

# E2E database (used only by Playwright)
E2E_DATABASE_URL=postgres://planeat:planeat@localhost:5434/planeat_e2e

# Session secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google login
GOOGLE_ID=
GOOGLE_SECRET=

# Web Push (generate with: mise exec -- pnpm push:generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron authentication
CRON_SECRET=

# Vercel Flags (populated by Vercel; run `vercel env pull` for local use)
FLAGS=
FLAGS_SECRET=
