# Copy this file to .env.e2e for local Playwright runs.
E2E_DATABASE_URL=postgres://planeat:planeat@localhost:5434/planeat_e2e

PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=planeat-e2e-only-secret

# NextAuth requires these when loading the auth module. E2E tests do not use
# the Google provider.
GOOGLE_ID=planeat-e2e-google-id
GOOGLE_SECRET=planeat-e2e-google-secret
