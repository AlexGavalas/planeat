{
    "name": "planeat",
    "private": true,
    "version": "0.0.1",
    "engines": {
        "node": "24"
    },
    "packageManager": "pnpm@12.3.1",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "build:analyze": "cross-env ANALYZE=true next build --webpack",
        "vercel-build": "if [ \"$VERCEL_ENV\" = \"preview\" ] || [ \"$VERCEL_ENV\" = \"production\" ]; then pnpm db:migrate; fi && pnpm build",
        "start": "next start",
        "preview": "pnpm build && pnpm start",
        "test": "TZ=UTC jest",
        "test:e2e": "playwright test",
        "test:e2e:watch": "playwright test --ui",
        "test:coverage": "TZ=UTC jest --coverage",
        "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand --watch",
        "test:watch": "TZ=UTC jest --watch",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:local:up": "docker compose up -d postgres",
        "db:local:down": "docker compose down",
        "db:e2e:up": "docker compose up -d postgres-e2e",
        "db:e2e:down": "docker compose stop postgres-e2e",
        "lint": "eslint .",
        "prettier": "prettier --experimental-cli",
        "check:format": "pnpm prettier --list-different .",
        "check:types": "tsc --noEmit",
        "format": "pnpm prettier --write",
        "format:all": "pnpm format .",
        "prepare": "husky install",
        "validate": "pnpm lint && pnpm check:format && pnpm check:types"
    },
    "dependencies": {
        "@mantine/core": "9.6.2",
        "@mantine/dates": "9.6.2",
        "@mantine/form": "9.6.2",
        "@mantine/hooks": "9.6.2",
        "@mantine/modals": "9.6.2",
        "@mantine/notifications": "9.6.2",
        "@nivo/bar": "0.99.0",
        "@nivo/core": "0.99.0",
        "@nivo/line": "0.99.0",
        "@tanstack/react-query": "5.103.2",
        "cheerio": "1.0.0-rc.12",
        "date-fns": "2.30.0",
        "date-fns-tz": "2.0.0",
        "dayjs": "1.11.10",
        "drizzle-orm": "0.45.2",
        "i18next": "23.16.8",
        "iconoir-react": "7.12.1",
        "jotai": "2.5.0",
        "lodash": "4.18.1",
        "mammoth": "1.6.0",
        "next": "16.3.6",
        "next-auth": "4.24.15",
        "next-i18next": "16.3.1",
        "postgres": "3.4.9",
        "react": "19.3.0",
        "react-dnd": "16.0.1",
        "react-dnd-html5-backend": "16.0.1",
        "react-dom": "19.3.0",
        "react-i18next": "14.1.3",
        "react-joyride": "3.2.0",
        "react-to-print": "3.3.0",
        "tiny-invariant": "1.3.1",
        "zod": "3.22.4"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.3",
        "@commitlint/config-conventional": "21.2.3",
        "@next/bundle-analyzer": "16.3.6",
        "@playwright/test": "1.63.0",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@trivago/prettier-plugin-sort-imports": "6.0.2",
        "@types/jest": "29.5.14",
        "@types/jest-axe": "3.5.9",
        "@types/lodash": "4.17.25",
        "@types/node": "24.19.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "cross-env": "7.0.3",
        "dotenv": "17.4.2",
        "drizzle-kit": "0.31.10",
        "eslint": "9.39.5",
        "eslint-config-next": "16.3.6",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-jest": "29.16.6",
        "eslint-plugin-testing-library": "7.16.2",
        "husky": "8.0.3",
        "identity-obj-proxy": "3.0.0",
        "jest": "29.7.0",
        "jest-axe": "11.0.0",
        "jest-environment-jsdom": "29.7.0",
        "lint-staged": "17.5.1",
        "next-router-mock": "1.0.5",
        "prettier": "3.9.9",
        "ts-jest": "29.4.14",
        "ts-node": "10.9.1",
        "typescript": "5.2.2",
        "typescript-eslint": "8.70.1"
    }
}
